# ── App ─────────────────────────────────────────────────────
APP_NAME=Niamind
APP_ENV=development
DEBUG=True
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
API_VERSION=v1

# ── Database ────────────────────────────────────────────────
# Local application database
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/niamind

# Test database used by pytest
TEST_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/niamind_test

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=niamind

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis_password_123@localhost:6379/0

REDIS_PASSWORD=redis_password_123
REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_CACHE_DB=0
REDIS_PUBSUB_DB=1
REDIS_CELERY_DB=2
REDIS_CELERY_RESULTS_DB=3

# Redis used by pytest
TEST_REDIS_URL=redis://:redis_password_123@localhost:6380/4
REDIS_TEST_DB=4

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_password_123@localhost:6379/2
CELERY_RESULT_BACKEND=redis://:redis_password_123@localhost:6379/3
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ── Auth ────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ── Email ───────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=contact@niamind.com
EMAIL_TLS=True

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=False

# ── Monitoring ──────────────────────────────────────────────
FLOWER_PORT=5555
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
